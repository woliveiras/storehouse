{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woliveiras/storehouse/catalog/collections.schema.json",
  "title": "Storehouse declarative collections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collections"],
  "properties": {
    "schema_version": { "const": 1 },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 },
          "skills": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          },
          "includes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          }
        },
        "anyOf": [{ "required": ["skills"] }, { "required": ["includes"] }]
      }
    }
  }
}
