{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woliveiras/storehouse/catalog/skills.schema.json",
  "title": "Storehouse provenance inventory",
  "type": "object",
  "required": ["schema_version", "source", "tuxedo_exclusion_source", "skills"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "type": "object" },
    "tuxedo_exclusion_source": { "type": "object" },
    "skills": { "type": "array", "minItems": 33, "maxItems": 33 }
  }
}
